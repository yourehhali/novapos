{
  "name": "appfront",
  "version": "0.0.0",
  "description": "NovaPOS desktop shell for offline-first point of sale operations.",
  "author": "NovaPOS",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "check": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "electron:build": "tsc -p tsconfig.electron.json",
    "desktop:dev": "concurrently -k \"npm:start\" \"npm:desktop:run\"",
    "desktop:run": "wait-on tcp:4200 && cross-env NOVAPOS_RENDERER_URL=http://localhost:4200 electron .",
    "desktop:build": "ng build --configuration production --base-href ./ && npm run electron:build",
    "desktop:package": "npm run desktop:build && electron-builder --publish never",
    "desktop:package:mac": "npm run desktop:build && electron-builder --publish never --mac dmg zip",
    "desktop:package:win": "npm run desktop:build && electron-builder --publish never --win nsis portable"
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "dexie": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "ma.rox.novapos.desktop",
    "productName": "NovaPOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/appfront/browser/**/*",
      "dist-electron/**/*",
      "electron/assets/**/*",
      "media/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "media/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "media/icon.png"
    },
    "linux": {
      "icon": "media/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
